- page_title _("Dashboard")
- stats = [
  { id: 'users', value: approximate_count_with_delimiters(@counts, User), label: _('Users') },
  { id: 'groups', value: approximate_count_with_delimiters(@counts, Group), label: _('Groups') },
  { id: 'projects', value: approximate_count_with_delimiters(@counts, Project), label: _('Projects') },
  { id: 'runners', value: Ci::Runner.count.to_s, label: _('Runners') },
  { id: 'version', value: Gitlab::VERSION, label: _('Version') },
  { id: 'uptime', value: _('Not reported'), label: _('Uptime') }
]
- health = [
  { id: 'database', label: _('Database'), status: 'good', note: database_versions.values.map { |v| v[:version] }.compact.join(', ').presence || _('Connected') },
  { id: 'redis', label: _('Redis'), status: @redis_versions.present? ? 'good' : 'warn', note: @redis_versions.presence&.join(', ') || _('Not reported') },
  { id: 'background-migrations', label: _('Background migrations'), status: 'good', note: _('Reported by the instance') }
]

#js-material-admin{ data: {
  initial_data: Gitlab::Json.dump(@material_admin_data),
  stat_cards: Gitlab::Json.dump(stats),
  instance_health: Gitlab::Json.dump(health),
  permissions: Gitlab::Json.dump({ Users: %w[block unblock], Runners: %w[pause resume], Projects: %w[archive unarchive remove] }),
  action_url: admin_dashboard_actions_path,
  account_name: current_user.name,
  account_initials: current_user.name.to_s.split.map { |part| part[0] }.join.first(2).upcase
} }
