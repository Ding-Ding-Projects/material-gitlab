- breadcrumb_title _("General Settings")
- page_title _("General")
- add_page_specific_style 'page_bundles/projects_edit'
- duo_settings_form_id = 'duo-settings-form'

%h1.gl-sr-only= @breadcrumb_title

- if can?(current_user, :admin_project, @project)
  - material_settings_data = { project_id: @project.id, full_path: @project.full_path, project_endpoint: project_path(@project, format: :json), api_base: "#{Gitlab.config.gitlab.relative_url_root}/api/v4", graphql_endpoint: "#{Gitlab.config.gitlab.relative_url_root}/api/graphql", user_name: current_user.name, user_initials: current_user.name.split.map { |part| part.first }.first(2).join, integration_settings_path: project_settings_integrations_path(@project), permissions: { project: can?(current_user, :admin_project, @project), members: can?(current_user, :admin_project_member, @project), variables: can?(current_user, :admin_cicd_variables, @project), branches: can?(current_user, :admin_protected_branch, @project), integrations: can?(current_user, :admin_project_integrations, @project) } }
  #material-project-settings{ data: { material_project_settings: material_settings_data.deep_transform_keys { |key| key.to_s.camelize(:lower) }.to_json } }
- elsif can?(current_user, :update_sec_ai_workflow_settings, @project)
  = render 'projects/settings/gitlab_duo', duo_settings_form_id: duo_settings_form_id
- else
  = render 'projects/settings/archive', project: @project
  = render 'delete'
