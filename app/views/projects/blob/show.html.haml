- breadcrumb_title _('Repository')
- page_title _('Repository'), @ref
- add_page_specific_style 'page_bundles/tree'

- if @gitaly_unavailable
  = render 'shared/errors/gitaly_unavailable', reason: _("Unable to load repository data")
- else
  #js-material-repository-app{ data: { project_path: @project.full_path, ref: current_ref, ref_type: @ref_type, path: @blob.path, entry_type: 'blob', starred: (current_user && current_user.starred?(@project)).to_s } }
  %nav{ 'aria-label': _('File actions') }
    = link_to (_('History of %{file}') % { file: @blob.path }), project_commits_path(@project, tree_join(current_ref, @blob.path), ref_type: @ref_type)
    = link_to (_('Blame %{file}') % { file: @blob.path }), project_blame_path(@project, @id, ref_type: @ref_type)
    - if can?(current_user, :push_code, @project)
      = link_to (_('Edit %{file}') % { file: @blob.path }), edit_blob_path(@project, current_ref, @blob.path)
  #js-ambiguous-ref-modal{ data: { ambiguous: @is_ambiguous_ref.to_s, ref: current_ref } }
