- page_title _("Merge requests")
- merge_project = merge_request_source_project_for_project(@project)
- new_merge_request_path = merge_project && project_new_merge_request_path(merge_project)

= content_for :meta_tags do
  = auto_discovery_link_tag(:atom, safe_params.merge(rss_url_options).to_h, title: "#{@project.name} merge requests")

= render 'projects/last_push'

#material-project-merge-requests{ data: { material_merge_requests: true, material_topbar_owner: 'surface.merge-requests', project_path: @project.full_path, current_user: (current_user ? { id: current_user.id, name: current_user.name, username: current_user.username, initials: current_user.name.split.map { |part| part.first }.first(2).join } : {}).to_json, can_create: new_merge_request_path.present?, can_update: can?(current_user, :admin_merge_request, @project), new_merge_request_path: new_merge_request_path } }
