{
  "name": "material-gitlab-deployer",
  "private": true,
  "version": "0.2.0",
  "description": "One-click Windows host for the Material GitLab Docker container.",
  "author": "Material GitLab Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ding-Ding-Projects/material-gitlab.git"
  },
  "productName": "Material GitLab Host",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "electron .",
    "package:squirrel": "electron-builder --win squirrel --publish never"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "uk.dewhui.material-gitlab-deployer",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*.js",
      "dist/renderer/**/*",
      "package.json"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "squirrelWindows": {
      "artifactName": "Setup.exe",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/material-gitlab/main/tools/material-gitlab-deployer/build/icon.ico",
      "msi": false
    },
    "productName": "Material GitLab Host",
    "extraResources": [
      {
        "from": "../../docker-compose.yml",
        "to": "host/docker-compose.yml"
      },
      {
        "from": "../../deploy/windows",
        "to": "host/deploy/windows",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../deploy/docker",
        "to": "host/deploy/docker",
        "filter": [
          "**/*",
          "!packages/*.deb"
        ]
      }
    ]
  }
}
