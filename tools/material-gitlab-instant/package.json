{
  "name": "material-gitlab-instant",
  "private": true,
  "version": "0.1.0",
  "description": "A configuration-only GitLab local-instance Electron shell.",
  "author": "GitLab",
  "main": "main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "electron .",
    "package": "electron-builder --win squirrel"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^36.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.materialgitlab.instant",
    "productName": "GitLab Instant",
    "icon": "build/icon.ico",
    "files": [
      {
        "from": "dist",
        "to": ".",
        "filter": ["**/*"]
      },
      {
        "from": "package.json",
        "to": "package.json"
      }
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": "squirrel",
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "squirrelWindows": {
      "msi": false,
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/material-gitlab/main/tools/material-gitlab-instant/build/icon.ico"
    }
  }
}
