{
  "name": "material-gitlab-instant",
  "private": true,
  "version": "0.1.0",
  "description": "A configuration-only GitLab local-instance Electron shell with explicit readiness states.",
  "author": "Ding-Ding Projects",
  "license": "MIT",
  "homepage": "https://github.com/Ding-Ding-Projects/material-gitlab",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ding-Ding-Projects/material-gitlab",
    "directory": "tools/material-gitlab-instant"
  },
  "main": "app-dist/main.js",
  "scripts": {
    "build": "node scripts/copy-assets.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "start": "electron .",
    "package": "electron-builder --win squirrel"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.materialgitlab.instant",
    "productName": "GitLab Instant",
    "directories": {
      "output": "installer"
    },
    "icon": "build/icon.ico",
    "copyright": "Copyright © 2026 Ding-Ding Projects",
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": "squirrel",
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "squirrelWindows": {
      "artifactName": "Setup.exe",
      "msi": false,
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/material-gitlab/main/tools/material-gitlab-instant/build/icon.ico"
    }
  }
}
